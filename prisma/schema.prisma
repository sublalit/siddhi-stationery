datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  productCount Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Vendor {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  status        String    @default("Active")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String?  @unique
  name           String
  email          String   @unique
  role           Role      @default(STAFF)
  avatarUrl      String?
  expenses       Expense[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  sku              String         @unique
  barcode          String?
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  currentStock     Int            @default(0)
  minStock         Int            @default(5)
  maxStock         Int            @default(500)
  sellingPrice     Float
  costPrice        Float
  unit             String         @default("units")
  rackLocation     String?        @default("A1-B1-S1")
  imageUrl         String?
  description      String?
  isCustomPrinting Boolean        @default(false)
  paperGsmOptions  String?
  printSides       String?
  finishTypes      String?
  inventoryLogs    InventoryLog[]
  invoiceItems     InvoiceItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerGstin   String?
  subtotal        Float
  gstAmount       Float         @default(0)
  discountTotal   Float         @default(0)
  grandTotal      Float
  paymentStatus   String        @default("Pending")
  paymentMethod   String        @default("Cash")
  notes           String?
  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  sku             String
  quantity        Int
  unitPrice       Float
  discountPercent Float    @default(0)
  lineTotal       Float
}

model InventoryLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  type        String
  quantity    Int
  remaining   Int?
  unitPrice   Float?
  supplier    String?  @default("General Supplier")
  batch       String?
  reason      String
  referenceId String?
  performedBy String   @default("Admin User")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PrintingRequest {
  id              String   @id @default(cuid())
  customerName    String
  customerContact String
  serviceType     String
  quantity        Int
  paperGsm        String?
  printSides      String?
  finishType      String?
  estimatedCost   Float
  status          String   @default("Pending")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentMode {
  CASH
  UPI
}

model Transaction {
  id          String      @id @default(cuid())
  amount      Float
  paymentMode PaymentMode
  note        String?
  isVoid      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}

model DailyLedger {
  id              String   @id @default(cuid())
  date            DateTime @unique
  openingBalance  Float    @default(0)
  totalCash       Float
  totalUPI        Float
  totalSales      Float
  totalExpenses   Float    @default(0)
  netExpectedCash Float    @default(0)
  isManualEntry   Boolean  @default(false)
  closedByRole    String
  createdAt       DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  amount    Float
  reason    String
  userId    String?
  addedBy   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model QuickNotePreset {
  id        String   @id @default(cuid())
  text      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

