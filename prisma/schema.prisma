datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

// `isDemo` partitions every business table into two isolated datasets:
// demo accounts (@example.com) only ever read/write rows where isDemo = true,
// real accounts only ever read/write rows where isDemo = false.

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String
  description  String?
  productCount Int       @default(0)
  isDemo       Boolean   @default(false)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, isDemo])
  @@unique([slug, isDemo])
  @@index([isDemo])
}

model Vendor {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  status        String    @default("Active")
  isDemo        Boolean   @default(false)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isDemo])
}

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String?  @unique
  name           String
  email          String   @unique
  role           Role      @default(STAFF)
  isApproved     Boolean   @default(false)
  isDemo         Boolean   @default(false)
  avatarUrl      String?
  expenses       Expense[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  sku              String
  barcode          String?
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  currentStock     Int            @default(0)
  minStock         Int            @default(5)
  maxStock         Int            @default(500)
  sellingPrice     Float
  costPrice        Float
  unit             String         @default("units")
  rackLocation     String?        @default("A1-B1-S1")
  imageUrl         String?
  description      String?
  isCustomPrinting Boolean        @default(false)
  paperGsmOptions  String?
  printSides       String?
  finishTypes      String?
  isDemo           Boolean        @default(false)
  inventoryLogs    InventoryLog[]
  invoiceItems     InvoiceItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([sku, isDemo])
  @@index([isDemo])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerGstin   String?
  subtotal        Float
  gstAmount       Float         @default(0)
  discountTotal   Float         @default(0)
  grandTotal      Float
  paymentStatus   String        @default("Pending")
  paymentMethod   String        @default("Cash")
  notes           String?
  isDemo          Boolean       @default(false)
  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([invoiceNumber, isDemo])
  @@index([isDemo])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  sku             String
  quantity        Int
  unitPrice       Float
  discountPercent Float    @default(0)
  lineTotal       Float
}

model InventoryLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  type        String
  quantity    Int
  remaining   Int?
  unitPrice   Float?
  supplier    String?  @default("General Supplier")
  batch       String?
  reason      String
  referenceId String?
  performedBy String   @default("Admin User")
  isDemo      Boolean  @default(false)
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDemo])
}

model PrintingRequest {
  id              String   @id @default(cuid())
  customerName    String
  customerContact String
  serviceType     String
  quantity        Int
  paperGsm        String?
  printSides      String?
  finishType      String?
  estimatedCost   Float
  status          String   @default("Pending")
  notes           String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isDemo])
}

enum PaymentMode {
  CASH
  UPI
}

model Transaction {
  id          String      @id @default(cuid())
  amount      Float
  paymentMode PaymentMode
  note        String?
  isVoid      Boolean     @default(false)
  isDemo      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([isDemo, createdAt])
}

model DailyLedger {
  id              String   @id @default(cuid())
  date            DateTime
  openingBalance  Float    @default(0)
  totalCash       Float
  totalUPI        Float
  totalSales      Float
  totalExpenses   Float    @default(0)
  netExpectedCash Float    @default(0)
  isManualEntry   Boolean  @default(false)
  closedByRole    String
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([date, isDemo])
}

model Expense {
  id        String   @id @default(cuid())
  amount    Float
  reason    String
  userId    String?
  addedBy   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isDemo, createdAt])
}

model QuickNotePreset {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([text, isDemo])
}
